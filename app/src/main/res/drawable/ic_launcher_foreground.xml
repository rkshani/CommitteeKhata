<?xml version="1.0" encoding="utf-8"?>
<!-- "CK" monogram for Committee Khata: the C is the committee circle,
     the K sits inside it, and a gold coin waits in the C's opening (the payout turn). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- C: r=22 around the centre, opening of +/-50 degrees on the right -->
    <path
        android:strokeColor="#FFF3D6"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M68.14,70.85A22,22 0,1 1,68.14 37.15" />
    <!-- K -->
    <path
        android:strokeColor="#F5B841"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M47,44V64M60.5,43.5L48,54L60.5,64.5" />
    <!-- coin -->
    <path
        android:fillColor="#F5B841"
        android:pathData="M76,54m-3.5,0a3.5,3.5 0,1 1,7 0a3.5,3.5 0,1 1,-7 0" />
</vector>
